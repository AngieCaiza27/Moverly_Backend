# Configuración del Entorno
ENV=dev

# Base de Datos PostgreSQL
# Formato (opciones):
# - asyncpg (original): postgresql+asyncpg://usuario:contraseña@host:puerto/nombre_bd
# - psycopg async (recomendado para evitar compilación en Windows): postgresql+psycopg://usuario:contraseña@host:puerto/nombre_bd
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/moverly

# Si estás usando el contenedor Docker provisto, puedes copiar `.env.docker` a `.env`
# El contenedor usa: POSTGRES_USER=postgres, POSTGRES_PASSWORD=postgres, POSTGRES_DB=moverly

# Seguridad JWT
SECRET_KEY=tu-clave-secreta-muy-segura-cambiar-en-produccion
ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_ALGORITHM=HS256

# Configuración de la Aplicación
APP_NAME=Moverly Backend
DEBUG=True

# CORS (para desarrollo)
ALLOWED_ORIGINS=http://localhost:19006,http://localhost:3000

# Logging
LOG_LEVEL=INFO
