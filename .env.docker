# Environment file for running the PostgreSQL container for local development
# This mirrors the defaults used in the project (app/core/config.py and env.example)

ENV=dev

# PostgreSQL async URL using psycopg (async) driver
# When running the DB in Docker and connecting from the host use 'localhost'
# When connecting from another container set host to 'db' (see docs/DOCKER.md)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/moverly

# App settings (optional overrides when running locally)
SECRET_KEY=change-me-in-prod
ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_ALGORITHM=HS256
APP_NAME=Moverly Backend (Docker)
DEBUG=True
